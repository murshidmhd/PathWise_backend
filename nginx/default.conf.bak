# --- Block 1: Redirect all HTTP to HTTPS ---
server {
    listen 80;
    server_name pathwise.duckdns.org;
#    return 301 https://$host$request_uri;
    location /api/ {
        proxy_pass http://django:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Standard CORS headers for all methods
        add_header 'Access-Control-Allow-Origin' 'http://localhost:5173' always;
    }

}

# --- Block 2: The Secure HTTPS Server ---
server {
    listen 443 ssl;
    server_name pathwise.duckdns.org;

    # SSL Certificate paths (using the one you already have)
    ssl_certificate /etc/letsencrypt/live/pathwise.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pathwise.duckdns.org/privkey.pem;

    # Root redirect to Vercel
    location / {
        return 301 https://path-wise-frontend.vercel.app$request_uri;
    }

    # 2. Django Backend (API)
    location /api/ {
        proxy_pass http://django:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
# 3. Add CORS to the proxy response too
#        add_header 'Access-Control-Allow-Origin' 'http://localhost:5173' always;
#	add_header 'Access-Control-Allow-Credentials' 'true' always;

    location /api/chat/ {
        proxy_pass http://websocket:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }    

    # 3. WebSocket Service
    location /ws/ {
    proxy_pass http://websocket:8001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Optional: WebSockets often need longer timeouts so they don't close randomly
    proxy_read_timeout 86400; 
}
    # 4. FastAPI AI Service
    location /ai/ {
        proxy_pass http://ai-service:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
